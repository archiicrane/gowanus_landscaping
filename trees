console.log('trees.js loaded');

window.TreeRenderer = {
  async initTrees(map) {
    try {
      console.log('initTrees called');

      const response = await fetch('./data/gowanus_trees.json');

      if (!response.ok) {
        throw new Error(`Trees fetch failed: ${response.status} ${response.statusText}`);
      }

      const rawData = await response.json();

      console.log('Tree raw data:', rawData);
      console.log(
        'Tree sample:',
        Array.isArray(rawData) ? rawData[0] : rawData?.features?.[0]
      );

      let features = [];

      if (rawData?.type === 'FeatureCollection' && Array.isArray(rawData.features)) {
        features = rawData.features;
      } else if (Array.isArray(rawData) && rawData.length > 0 && 'lat' in rawData[0] && 'lon' in rawData[0]) {
        features = rawData
          .filter((t) => t.lat != null && t.lon != null)
          .map((t) => ({
            type: 'Feature',
            geometry: {
              type: 'Point',
              coordinates: [Number(t.lon), Number(t.lat)]
            },
            properties: {
              species: t.species || 'Unknown'
            }
          }));
      } else if (Array.isArray(rawData) && rawData.length > 0 && 'latitude' in rawData[0] && 'longitude' in rawData[0]) {
        features = rawData
          .filter((t) => t.latitude != null && t.longitude != null)
          .map((t) => ({
            type: 'Feature',
            geometry: {
              type: 'Point',
              coordinates: [Number(t.longitude), Number(t.latitude)]
            },
            properties: {
              species: t.species || 'Unknown'
            }
          }));
      } else {
        console.error('Unknown tree data format:', rawData);
        return;
      }

      console.log('Tree feature count:', features.length);

      if (map.getLayer('trees-layer')) {
        map.removeLayer('trees-layer');
      }

      if (map.getSource('trees')) {
        map.removeSource('trees');
      }

      map.addSource('trees', {
        type: 'geojson',
        data: {
          type: 'FeatureCollection',
          features
        }
      });

      map.addLayer({
        id: 'trees-layer',
        type: 'circle',
        source: 'trees',
        layout: {
          visibility: 'visible'
        },
        paint: {
          'circle-radius': [
            'interpolate',
            ['linear'],
            ['zoom'],
            13, 3,
            15, 5,
            17, 8
          ],
          'circle-color': '#22c55e',
          'circle-opacity': 1,
          'circle-stroke-color': '#ffffff',
          'circle-stroke-width': 1.2
        }
      });

      console.log('trees-layer added');
    } catch (err) {
      console.error('TREE LOAD ERROR:', err);
    }
  },

  showTrees(map) {
    if (map.getLayer('trees-layer')) {
      map.setLayoutProperty('trees-layer', 'visibility', 'visible');
    }
  },

  hideTrees(map) {
    if (map.getLayer('trees-layer')) {
      map.setLayoutProperty('trees-layer', 'visibility', 'none');
    }
  }
};